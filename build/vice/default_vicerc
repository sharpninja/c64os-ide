# VICE Configuration File
# Default configuration for VICE C64 emulator
# Generated by build process: 2026-01-29
#
# This file is used by VICE to store emulator settings and preferences.
# It is located in: %APPDATA%\vice (Windows) or ~/.config/vice (Linux/Unix)
#
# Format: ResourceName=ResourceValue
# Sections are marked with [MachineName]

# Machine-specific settings are separated by sections:
# [C64], [C128], [VIC20], [PET], [PLUS4], [CBM2], [SCPU64], [CBM5x0], [DTV]

# Global Settings
[GLOBAL]
# Enable GTK3 UI (already default, for reference)
UIEnabled=1

# Autostart settings
AutostartOnDoubleClick=1

# Common Resource Settings
# These are used by multiple machines

# Video settings
FullscreenEnable=0

# Sound settings
SoundVolume=100

# Joystick settings
Joyport1Device=0
Joyport2Device=0

# Tape settings
TapeImageName=

# Printer settings
PrinterTextDevice1=
PrinterDevice4=0
PrinterDevice5=0

# ROM settings
# Note: Make sure ROM files are placed in the proper directory
# VICE will search in the data directory for these files

# Drive settings
Drive8Type=1541
Drive9Type=1541
Drive10Type=1541
Drive11Type=1541

# RS-232 device settings
RsDevice1Baud=9600

# Logging settings
LogFileName=vice.log

# Monitor settings (for the built-in monitor)
MonitorBG=0
MonitorFG=15
MonitorFont=

# End of default configuration
